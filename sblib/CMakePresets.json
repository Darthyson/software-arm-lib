{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 3
    },
    "configurePresets": [
        {
            "name": "default-build-directory",
            "description": "Sets the build directory",
            "hidden": true,
            "binaryDir": "${sourceDir}/cmake-build/${presetName}"
        },
        {
            "name": "default-generator-ninja",
            "description": "Sets the Ninja generator",
            "hidden": true,
            "generator": "Ninja"
        },
        {
            "name": "default-toolchain-arm-none-eabi",
            "description": "Sets Toolchain arm-none-eabi (using MCUXpresso)",
            "hidden": true,
            "toolchainFile": "${sourceDir}/../cmake/toolchains/arm-none-eabi_mcuxpresso.cmake"
        },
        {
            "name": "toolchain-prefix-windows",
            "description": "Sets Toolchain prefix to MCUXpresso on Windows",
            "hidden": true,
            "environment": {
                "MCUXPRESSO_TOOLCHAIN_PATH": "C:/nxp/MCUXpressoIDE_25.6.136/ide/tools"
            },
            "cacheVariables": {
                "TOOLCHAIN_PREFIX": {
                    "type": "STRING",
                    "value": "$env{MCUXPRESSO_TOOLCHAIN_PATH}"
                }
            }
        },
        {
            "name": "toolchain-prefix-linux",
            "description": "Sets Toolchain prefix to MCUXpresso on Linux",
            "hidden": true,
            "environment": {
                "MCUXPRESSO_TOOLCHAIN_PATH": "/usr/local/mcuxpressoide-25.6.136/ide/tools"
            },
            "cacheVariables": {
                "TOOLCHAIN_PREFIX": {
                    "type": "STRING",
                    "value": "$env{MCUXPRESSO_TOOLCHAIN_PATH}"
                }
            } 
        },
        {
            "name": "default-arm-windows",
            "description": "Sets Windows Toolchain arm-none-eabi (using MCUXpresso), build directory and Ninja generator",
            "hidden": true,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja",
                "default-toolchain-arm-none-eabi",
                "toolchain-prefix-windows"
            ]
        },
        {
            "name": "default-arm-linux",
            "description": "Sets Linux Toolchain arm-none-eabi (using MCUXpresso), build directory and Ninja generator",
            "hidden": true,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja",
                "default-toolchain-arm-none-eabi",
                "toolchain-prefix-linux"
            ]
        },
        {
            "name": "debug-arm-windows",
            "displayName": "ARM Debug Configure (Windows)",
            "description": "Sets Windows Toolchain arm-none-eabi (using MCUXpresso), build directory and Ninja generator",
            "inherits": [
                "default-arm-windows"
            ],
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-arm-windows",
            "displayName": "ARM Release Configure (Windows)",
            "description": "Sets Windows Toolchain arm-none-eabi (using MCUXpresso), build directory and Ninja generator",
            "inherits": [
                "default-arm-windows"
            ],
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug-arm-linux",
            "displayName": "ARM Debug Configure (Linux)",
            "description": "Sets Linux Toolchain arm-none-eabi (using MCUXpresso), build directory and Ninja generator",
            "inherits": [
                "default-arm-linux"
            ],
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-arm-linux",
            "displayName": "ARM Release Configure (Linux)",
            "description": "Sets Linux Toolchain arm-none-eabi (using MCUXpresso), build directory and Ninja generator",
            "inherits": [
                "default-arm-linux"
            ],
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "default-x86",
            "description": "Sets architecture x86, build directory and Ninja generator",
            "hidden": true,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja"
            ],
            "cacheVariables": {
                "SBLIB_ARCHITECTURE": "x86"
            }
        },
        {
            "name": "default-x64",
            "description": "Sets architecture x64, build directory and Ninja generator",
            "hidden": true,
            "inherits": [
                "default-build-directory",
                "default-generator-ninja"
            ],
            "cacheVariables": {
                "SBLIB_ARCHITECTURE": "x64"
            }
        },
        {
            "name": "debug-x86",
            "displayName": "x86 Debug Configure",
            "description": "Configure x86 Debug",
            "inherits": [
                "default-x86"
            ],
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-x86",
            "displayName": "x86 Release Configure",
            "description": "Configure x86 Release",
            "inherits": [
                "default-x86"
            ],
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug-x64",
            "displayName": "x64 Debug Configure",
            "description": "Configure x64 Debug",
            "inherits": [
                "default-x64"
            ],
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-x64",
            "displayName": "x64 Release Configure",
            "description": "Configure x64 Release",
            "inherits": [
                "default-x64"
            ],
            "hidden": false,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug-arm-windows",
            "configurePreset": "debug-arm-windows",
            "displayName": "ARM Target Debug Build Windows",
            "description": "Build ARM target in Debug configuration on Windows",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib"
            ],
            "jobs": 16
        },
        {
            "name": "Release-arm-windows",
            "configurePreset": "release-arm-windows",
            "displayName": "ARM Target Release Build Windows", 
            "description": "Build ARM target in Release configuration on Windows",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib"
            ],
            "jobs": 16
        }
        ,
        {
            "name": "Debug-arm-linux",
            "configurePreset": "debug-arm-linux",
            "displayName": "ARM Target Debug Build on Linux",
            "description": "Build ARM target in Debug configuration on Linux",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib"
            ],
            "jobs": 16
        },
        {
            "name": "Release-arm-linux",
            "configurePreset": "release-arm-linux",
            "displayName": "ARM Target Release Build on Linux", 
            "description": "Build ARM target in Release configuration on Linux",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib"
            ],
            "jobs": 16
        }
        ,
        {
            "name": "Debug-x86",
            "configurePreset": "debug-x86",
            "displayName": "x86 Target Debug Build",
            "description": "Build x86 target in Debug configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_x86"
            ],
            "jobs": 16
        },
        {
            "name": "Release-x86",
            "configurePreset": "release-x86",
            "displayName": "x86 Target Release Build",
            "description": "Build x86 target in Release configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_x86"
            ],
            "jobs": 16
        },
        {
            "name": "Debug-x64",
            "configurePreset": "debug-x64",
            "displayName": "x64 Target Debug Build",
            "description": "Build x64 target in Debug configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_x64"
            ],
            "jobs": 16
        },
        {
            "name": "Release-x64",
            "configurePreset": "release-x64",
            "displayName": "x64 Target Release Build",
            "description": "Build x64 target in Release configuration",
            "hidden": false,
            "verbose": true,
            "targets": [
                "sblib_x64"
            ],
            "jobs": 16
        }
    ]
}